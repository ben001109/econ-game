FROM oven/bun:1.1-alpine@sha256:ae1ee3f0e326ad8ae886bd500929e7f4fcb4986a1455d6d6ab2f3c2498036aad
WORKDIR /workspace/services/api

# Install dependencies
COPY services/api/package.json services/api/bun.lock* ./
COPY packages/econ-game-release-evidence /workspace/packages/econ-game-release-evidence
RUN bun install --frozen-lockfile

# Copy source and prisma schema
COPY services/api/tsconfig.json ./
COPY services/api/prisma ./prisma
COPY services/api/src ./src

# Generate Prisma Client in container
RUN apk add --no-cache openssl1.1-compat || apk add --no-cache openssl
RUN bunx prisma generate

ENV NODE_ENV=production
ENV NEW_RELIC_NO_CONFIG_FILE=true
ENV NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
ENV NEW_RELIC_LOG=stdout
ENV HOME=/tmp
RUN chown -R 65532:65532 /workspace
USER 65532:65532
EXPOSE 4000

# Database migrations are a separate reviewed release step; service startup is read-only.
CMD ["bun", "run", "bun:start"]
