generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Legacy Restaurant/POS enums and models remain available while the D01 P0
// persistence families are added alongside them.

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  SERVED
  CLOSED
  CANCELED
}

enum PaymentMethod {
  CASH
  CARD
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  INVENTORY
  VIEWER
}

enum SaveMode {
  COMPETITIVE
  SANDBOX
}

enum EmployeeKind {
  PLAYER
  NPC
}

enum InventoryTransactionKind {
  RECEIPT
  CONSUMPTION
  RESERVATION
  RELEASE
  WASTE
  ADJUSTMENT
}

enum InventoryPool {
  DURABLE
  PERISHABLE
}

enum FinancialRiskStatus {
  NORMAL
  DELINQUENT
  RESOLUTION
  REHAB
}

enum ReputationDimension {
  PRICE
  SPEED
  QUALITY
  FAIRNESS
  VIBE
}

enum WipeBatchStatus {
  DRAFT
  APPROVED
  ANNOUNCED
  SCHEDULED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
}

enum WipeLifecyclePhase {
  FROZEN
  ISOLATED
  CLEARED
  VERIFIED
}

enum WipeCheckpointOutcome {
  SUCCEEDED
  FAILED
}

enum WipeExecutionLeaseStatus {
  CLAIMED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum WipeAccountGuardOutcome {
  ELIGIBLE
  ACCOUNT_RETAINED_GUARD
}

enum WipeTombstoneFamily {
  CompetitiveSave
  Employee
  InventoryStock
  Order
  Player
  RestaurantMembership
}

enum TestCohortStatus {
  DRAFT
  OPEN
  CLOSED
  REVOKED
}

enum InviteStatus {
  DRAFT
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum CohortMembershipStatus {
  ACTIVE
  REVOKED
}

enum BootstrapProvisioningStatus {
  ACTIVE
  RETIRED
  CLEARED
}

enum ConsentDecisionKind {
  ACCEPTED
  WITHDRAWN
}

enum RewardEligibilitySource {
  SERVER_EVENT
  MANUAL_ADJUSTMENT
  REVOCATION
}

enum LedgerTransactionKind {
  POSTING
  COMPENSATION
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum SimulationArtifactKind {
  RULE
  CATALOG
}

enum SimulationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum SimulationJobErrorClass {
  TRANSIENT
  PERMANENT
}

enum BusinessDayStatus {
  PREOPEN
  OPEN
  SERVICE_COMPLETE
  SETTLED
}

enum MarketTickMaterializationSource {
  JOB
  COMMAND
}

model Player {
  id                            String                 @id @default(cuid())
  clerkUserId                   String                 @unique
  displayName                   String
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  identityLinks                 IdentityLink[]
  memberships                   RestaurantMembership[]
  ownedSaves                    CompetitiveSave[]
  auditLogs                     AuditLog[]
  employees                     Employee[]
  idempotencyRecords            IdempotencyRecord[]
  consumedDiscordLinkChallenges DiscordLinkChallenge[]
  cohortInvitesReceived         TestCohortInvite[]     @relation("D05InvitedPlayer")
  cohortInvitesIssued           TestCohortInvite[]     @relation("D05InviteIssuer")
  cohortInvitesConsumed         TestCohortInvite[]     @relation("D05InviteConsumer")
  cohortInvitesRevoked          TestCohortInvite[]     @relation("D05InviteRevoker")
  cohortMemberships             TestCohortMembership[] @relation("D05CohortMember")
  cohortMembershipRevocations   TestCohortMembership[] @relation("D05MembershipRevoker")
  testCohortsCreated            TestCohort[]           @relation("D05CohortCreator")
  consentPoliciesCreated        ConsentPolicy[]        @relation("D05ConsentPolicyCreator")
  consentDecisions              ConsentDecision[]      @relation("D05ConsentSubject")
  consentDecisionsActed         ConsentDecision[]      @relation("D05ConsentActor")
  rewardEligibilities           RewardEligibility[]    @relation("D05RewardSubject")
  rewardEligibilityDecisions    RewardEligibility[]    @relation("D05RewardDecider")
  ledgerTransactions            LedgerTransaction[]    @relation("D03LedgerActor")
  wipeBatchesRequested          WipeBatch[]             @relation("D05WipeRequester")
  wipeBatchesApproved           WipeBatch[]             @relation("D05WipeApprover")
  wipeCheckpointsRecorded       WipeBatchCheckpoint[]   @relation("D05WipeCheckpointActor")
  wipeAccountGuardEvaluations   WipeAccountGuardEvaluation[]
  wipeTombstones                WipeTombstone[]
  wipeExecutionLeasesRequested  WipeExecutionLease[]
  bootstrapAuthority            BootstrapAuthority?
  bootstrapProvisioningEpochs   BootstrapProvisioningEpoch[]
  bootstrapPlayerCommandState   BootstrapPlayerCommandState?

  @@unique([id, clerkUserId])
}

model IdentityLink {
  id             String    @id @default(cuid())
  playerId       String
  clerkUserId    String
  provider       String
  providerUserId String
  verifiedAt     DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  player         Player    @relation(fields: [playerId, clerkUserId], references: [id, clerkUserId], onDelete: Restrict)

  @@unique([provider, providerUserId])
  @@unique([clerkUserId, provider])
  @@index([playerId])
}

model DiscordLinkChallenge {
  id                 String    @id
  tokenDigest        String    @unique @db.VarChar(64)
  discordUserId      String
  correlationId      String
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByPlayerId String?
  createdAt          DateTime  @default(now())
  consumedByPlayer   Player?   @relation(fields: [consumedByPlayerId], references: [id], onDelete: Restrict)

  @@index([discordUserId, consumedAt])
  @@index([expiresAt, consumedAt])
  @@index([consumedByPlayerId, consumedAt])
}

model Restaurant {
  id                  String                       @id @default(cuid())
  name                String
  timezone            String                       @default("UTC")
  branches            Branch[]
  memberships         RestaurantMembership[]
  auditLogs           AuditLog[]
  competitiveSaves    CompetitiveSave[]
  employees           Employee[]
  wageContracts       WageContract[]
  employeeShifts      EmployeeShift[]
  menuCatalogs        MenuCatalog[]
  recipeVersions      RecipeVersion[]
  menuSelections      MenuSelection[]
  inventoryItems      InventoryItem[]
  inventoryStocks     InventoryStock[]
  inventoryTxs        InventoryTransaction[]
  inventoryPoolStates InventoryPoolState[]
  marketSeedAuthorities MarketSeedAuthority[]
  orders              Order[]
  menuItems           MenuItem[]
  orderItems          OrderItem[]
  orderServiceStates  OrderServiceState[]
  replayEvents        ReplayEvent[]
  dayEndSnapshots     DayEndSnapshot[]
  riskStates          RiskState[]
  reputationHistory   ReputationDimensionHistory[]
  loans               Loan[]
  loanInstallments    LoanInstallment[]
  wipeBatches         WipeBatch[]
  idempotencyRecords  IdempotencyRecord[]
  testCohorts         TestCohort[]
  bootstrapSourceEligibilityAuthorities BootstrapAuthority[]
  bootstrapProvisionedEpochs BootstrapProvisioningEpoch[]
  ledgerTransactions  LedgerTransaction[]
  outboxEvents        OutboxEvent[]
  outboxReceipts      OutboxConsumerReceipt[]
  outboxDeadLetters   OutboxConsumerDeadLetter[]
  simulationJobs      SimulationJob[]
  simulationJobAudits SimulationJobAudit[]
  marketTicks         MarketTick[]
  replayExecutions    VersionedReplayExecution[]
  businessDays        BusinessDay[]
  preopenDaySnapshots PreopenDaySnapshot[]
  servicePeriodExecutions ServicePeriodExecution[]
  createdAt           DateTime                     @default(now())
}

model TestCohort {
  id                       String                 @id
  restaurantId             String
  name                     String
  purpose                  String
  environment              String
  status                   TestCohortStatus       @default(DRAFT)
  quota                    Int
  opensAt                  DateTime
  closesAt                 DateTime
  featureFlags             Json
  eligibilityPolicyVersion String
  eligibilityPolicyDigest  String                 @db.VarChar(64)
  entryConsentPolicyId     String?
  createdByPlayerId        String
  openedAt                 DateTime?
  closedAt                 DateTime?
  revokedAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  restaurant               Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdBy                Player                 @relation("D05CohortCreator", fields: [createdByPlayerId], references: [id], onDelete: Restrict)
  consentPolicies          ConsentPolicy[]
  invites                  TestCohortInvite[]
  memberships              TestCohortMembership[]
  consentDecisions         ConsentDecision[]
  rewardEligibilities      RewardEligibility[]
  bootstrapAuthorities     BootstrapAuthority[]

  @@unique([restaurantId, id])
  @@index([restaurantId, status, opensAt, closesAt])
}

model ConsentPolicy {
  id                String            @id
  cohortId          String
  purpose           String
  version           String
  policyDigest      String            @db.VarChar(64)
  scope             Json
  dataCategories    Json
  retentionDays     Int
  requiredForEntry  Boolean           @default(false)
  createdByPlayerId String
  createdAt         DateTime          @default(now())
  retiredAt         DateTime?
  cohort            TestCohort        @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  createdBy         Player            @relation("D05ConsentPolicyCreator", fields: [createdByPlayerId], references: [id], onDelete: Restrict)
  decisions         ConsentDecision[]

  @@unique([cohortId, id])
  @@unique([cohortId, purpose, version])
  @@index([cohortId, requiredForEntry, retiredAt])
}

model TestCohortInvite {
  id                 String                @id
  cohortId           String
  invitedPlayerId    String
  issuedByPlayerId   String
  tokenDigest        String                @unique @db.VarChar(64)
  status             InviteStatus          @default(DRAFT)
  expiresAt          DateTime
  activatedAt        DateTime?
  consumedAt         DateTime?
  consumedByPlayerId String?
  revokedAt          DateTime?
  revokedByPlayerId  String?
  createdAt          DateTime              @default(now())
  cohort             TestCohort            @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  invitedPlayer      Player                @relation("D05InvitedPlayer", fields: [invitedPlayerId], references: [id], onDelete: Restrict)
  issuedBy           Player                @relation("D05InviteIssuer", fields: [issuedByPlayerId], references: [id], onDelete: Restrict)
  consumedBy         Player?               @relation("D05InviteConsumer", fields: [consumedByPlayerId], references: [id], onDelete: Restrict)
  revokedBy          Player?               @relation("D05InviteRevoker", fields: [revokedByPlayerId], references: [id], onDelete: Restrict)
  membership         TestCohortMembership?
  bootstrapAuthority BootstrapAuthority?

  @@unique([cohortId, id])
  @@index([cohortId, status, expiresAt])
  @@index([invitedPlayerId, status])
}

model TestCohortMembership {
  id                String                 @id
  cohortId          String
  playerId          String
  inviteId          String                 @unique
  status            CohortMembershipStatus @default(ACTIVE)
  joinedAt          DateTime               @default(now())
  revokedAt         DateTime?
  revokedByPlayerId String?
  revokeReason      String?
  cohort            TestCohort             @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  player            Player                 @relation("D05CohortMember", fields: [playerId], references: [id], onDelete: Restrict)
  invite            TestCohortInvite       @relation(fields: [cohortId, inviteId], references: [cohortId, id], onDelete: Restrict)
  revokedBy         Player?                @relation("D05MembershipRevoker", fields: [revokedByPlayerId], references: [id], onDelete: Restrict)
  bootstrapAuthority BootstrapAuthority?

  @@unique([cohortId, playerId])
  @@unique([cohortId, inviteId])
  @@index([playerId, status])
  @@index([cohortId, status])
}

model ConsentDecision {
  id               String              @id
  decisionSequence BigInt              @unique @default(autoincrement())
  cohortId         String
  playerId         String
  policyId         String
  actorPlayerId    String
  decision         ConsentDecisionKind
  policyVersion    String
  policyDigest     String              @db.VarChar(64)
  purpose          String
  scope            Json
  dataCategories   Json
  retentionUntil   DateTime
  acceptedAt       DateTime?
  withdrawnAt      DateTime?
  createdAt        DateTime            @default(now())
  cohort           TestCohort          @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  player           Player              @relation("D05ConsentSubject", fields: [playerId], references: [id], onDelete: Restrict)
  actor            Player              @relation("D05ConsentActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)
  policy           ConsentPolicy       @relation(fields: [cohortId, policyId], references: [cohortId, id], onDelete: Restrict)
  bootstrapAuthority BootstrapAuthority?

  @@index([cohortId, playerId, policyId, decisionSequence])
  @@index([playerId, purpose, decisionSequence])
}

model RewardEligibility {
  id                      String                  @id
  cohortId                String
  playerId                String
  policyVersion           String
  policyDigest            String                  @db.VarChar(64)
  milestoneEventId        String
  evidenceSnapshot        Json
  evidenceHash            String                  @db.VarChar(64)
  eligible                Boolean
  rewardKind              String
  source                  RewardEligibilitySource
  reason                  String
  decidedByPlayerId       String?
  decidedAt               DateTime                @default(now())
  revokedAt               DateTime?
  supersedesEligibilityId String?
  cohort                  TestCohort              @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  player                  Player                  @relation("D05RewardSubject", fields: [playerId], references: [id], onDelete: Restrict)
  decidedBy               Player?                 @relation("D05RewardDecider", fields: [decidedByPlayerId], references: [id], onDelete: Restrict)
  supersedes              RewardEligibility?      @relation("D05RewardSupersession", fields: [cohortId, playerId, rewardKind, supersedesEligibilityId], references: [cohortId, playerId, rewardKind, id], onDelete: Restrict)
  supersededBy            RewardEligibility?      @relation("D05RewardSupersession")

  @@unique([cohortId, playerId, rewardKind, id])
  @@unique([cohortId, playerId, rewardKind, supersedesEligibilityId])
  @@index([playerId, eligible, revokedAt])
  @@index([cohortId, decidedAt])
  @@index([cohortId, playerId, milestoneEventId])
}

model RestaurantMembership {
  id           String            @id @default(cuid())
  playerId     String
  restaurantId String
  role         MembershipRole
  branchScope  Json?
  createdAt    DateTime          @default(now())
  revokedAt    DateTime?
  player       Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  ownedSaves   CompetitiveSave[] @relation("CompetitiveSaveOwnerMembership")
  wipeTombstones WipeTombstone[]
  bootstrapProvisioningEpoch BootstrapProvisioningEpoch?

  @@unique([playerId, restaurantId])
  @@index([restaurantId, revokedAt])
  @@index([playerId, revokedAt])
}

model AuditLog {
  id            String      @id @default(cuid())
  restaurantId  String?
  actorPlayerId String?
  actorType     String
  action        String
  targetType    String
  targetId      String
  metadata      Json
  correlationId String?
  createdAt     DateTime    @default(now())
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  actorPlayer   Player?     @relation(fields: [actorPlayerId], references: [id], onDelete: Restrict)
  bootstrapOwnerAuditEpoch BootstrapProvisioningEpoch?

  @@index([restaurantId, createdAt])
  @@index([actorPlayerId, createdAt])
  @@index([targetType, targetId])
}

model CompetitiveSave {
  id                    String                       @id @default(cuid())
  restaurantId          String
  ownerPlayerId         String
  mode                  SaveMode
  version               Int                          @default(1)
  openingScenario       String
  operatingMode         String
  servicePeriodPlan     String
  difficultyGroup       String
  demandSeed            String
  simulationRuleVersion String
  openingSnapshot       Json
  openingSnapshotHash   String                       @db.VarChar(64)
  retiredAt             DateTime?
  retiredByWipeBatchId  String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  restaurant            Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  ownerPlayer           Player                       @relation(fields: [ownerPlayerId], references: [id], onDelete: Restrict)
  ownerMembership       RestaurantMembership         @relation("CompetitiveSaveOwnerMembership", fields: [ownerPlayerId, restaurantId], references: [playerId, restaurantId], onDelete: Restrict)
  retiredByWipeBatch    WipeBatch?                   @relation(fields: [retiredByWipeBatchId], references: [id], onDelete: Restrict)
  wipeBatchScopes       WipeBatchSaveScope[]
  wipeTombstones        WipeTombstone[]
  employees             Employee[]
  wageContracts         WageContract[]
  employeeShifts        EmployeeShift[]
  menuSelections        MenuSelection[]
  inventoryStocks       InventoryStock[]
  inventoryTxs          InventoryTransaction[]
  inventoryPoolStates   InventoryPoolState[]
  marketSeedAuthority   MarketSeedAuthority?
  orders                Order[]
  replayEvents          ReplayEvent[]
  dayEndSnapshots       DayEndSnapshot[]
  riskStates            RiskState[]
  reputationHistory     ReputationDimensionHistory[]
  loans                 Loan[]
  ledgerTransactions    LedgerTransaction[]
  outboxEvents          OutboxEvent[]
  simulationJobs        SimulationJob[]
  marketTicks           MarketTick[]
  replayExecutions      VersionedReplayExecution[]
  businessDays          BusinessDay[]
  preopenDaySnapshots   PreopenDaySnapshot[]
  servicePeriodExecutions ServicePeriodExecution[]
  bootstrapProvisioningEpoch BootstrapProvisioningEpoch?

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, version])
  @@index([restaurantId, retiredAt])
  @@index([ownerPlayerId, retiredAt])
}

model BusinessDay {
  id                        String
  restaurantId              String
  saveId                    String
  businessDay               Int
  status                    BusinessDayStatus @default(PREOPEN)
  servicePeriodPlan         String
  simulationRuleVersion     String
  createdByCommandId        String            @unique
  openedByCommandId         String?           @unique
  settledByCommandId        String?           @unique
  consumedPreopenSnapshotId String?
  openSnapshot              Json?
  openSnapshotHash          String?           @db.VarChar(64)
  createdAt                 DateTime          @default(now())
  openedAt                  DateTime?
  settledAt                 DateTime?
  restaurant                Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                      CompetitiveSave   @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  consumedPreopenSnapshot   PreopenDaySnapshot? @relation("BusinessDayConsumedPreopenSnapshot", fields: [restaurantId, saveId, businessDay, consumedPreopenSnapshotId], references: [restaurantId, saveId, businessDay, id], onDelete: Restrict)
  preopenSnapshots          PreopenDaySnapshot[] @relation("PreopenSnapshotBusinessDay")
  servicePeriodExecutions   ServicePeriodExecution[]
  replayEvents              ReplayEvent[]
  dayEndSnapshots           DayEndSnapshot[]
  replayExecutions          VersionedReplayExecution[]
  marketTicks               MarketTick[]

  @@id([restaurantId, id])
  @@unique([saveId, businessDay])
  @@unique([restaurantId, saveId, businessDay])
  @@index([restaurantId, status])
}

model PreopenDaySnapshot {
  id                    String
  restaurantId          String
  saveId                String
  businessDay           Int
  revision              Int
  commandId             String          @unique
  snapshotSchemaVersion String
  simulationRuleVersion String
  payload               Json
  snapshotHash          String          @db.VarChar(64)
  createdAt             DateTime        @default(now())
  restaurant            Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                  CompetitiveSave @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  businessDayRecord     BusinessDay     @relation("PreopenSnapshotBusinessDay", fields: [restaurantId, saveId, businessDay], references: [restaurantId, saveId, businessDay], onDelete: Restrict)
  consumedByBusinessDays BusinessDay[]  @relation("BusinessDayConsumedPreopenSnapshot")

  @@id([restaurantId, id])
  @@unique([saveId, businessDay, revision])
  @@unique([restaurantId, saveId, businessDay, id])
  @@index([restaurantId, saveId, businessDay])
}

model ServicePeriodExecution {
  id                    String
  restaurantId          String
  saveId                String
  businessDay           Int
  ordinal               Int
  periodKey             String
  commandId             String          @unique
  simulationRuleVersion String
  inputSnapshot         Json
  inputHash             String          @db.VarChar(64)
  resultSnapshot        Json
  resultHash            String          @db.VarChar(64)
  completedAt           DateTime
  restaurant            Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                  CompetitiveSave @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  businessDayRecord     BusinessDay     @relation(fields: [restaurantId, saveId, businessDay], references: [restaurantId, saveId, businessDay], onDelete: Restrict)
  replayEvents          ReplayEvent[]

  @@id([restaurantId, id])
  @@unique([saveId, businessDay, ordinal])
  @@unique([saveId, businessDay, periodKey])
  @@unique([restaurantId, saveId, businessDay, id])
  @@index([restaurantId, saveId, businessDay])
}

/// Immutable server-created binding from one qualifying closed-beta invite/consent
/// context to every allowed provisioning epoch for that player.
model BootstrapAuthority {
  id                      String   @id
  playerId                String   @unique
  cohortId                String
  cohortMembershipId      String   @unique
  inviteId                String   @unique
  consentDecisionId       String   @unique
  sourceEligibilityRestaurantId String
  policyVersion           String
  policyDigest            String   @db.VarChar(64)
  createdAt               DateTime @default(now())
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  cohort                  TestCohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  cohortMembership        TestCohortMembership @relation(fields: [cohortMembershipId], references: [id], onDelete: Restrict)
  invite                  TestCohortInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  consentDecision         ConsentDecision @relation(fields: [consentDecisionId], references: [id], onDelete: Restrict)
  sourceEligibilityRestaurant Restaurant @relation(fields: [sourceEligibilityRestaurantId], references: [id], onDelete: Restrict)
  epochs                  BootstrapProvisioningEpoch[]

  @@index([cohortId, playerId])
  @@index([sourceEligibilityRestaurantId])
}

/// Forward-only isolated restaurant/save epochs. Partial uniqueness and transition
/// guards are expressed in the paired PostgreSQL migration because Prisma cannot
/// represent partial unique indexes or transition triggers.
model BootstrapProvisioningEpoch {
  id                    String                      @id
  authorityId           String
  playerId              String
  epochNumber           Int
  playerCommandVersion  Int
  predecessorEpochId    String?                     @unique
  status                BootstrapProvisioningStatus @default(ACTIVE)
  provisionedRestaurantId String                    @unique
  ownerMembershipId     String                      @unique
  saveId                String                      @unique
  ownerAuditLogId       String                      @unique
  commandId             String                      @unique
  requestFingerprint    String                      @db.VarChar(64)
  createdAt             DateTime                    @default(now())
  retiredAt             DateTime?
  clearedAt             DateTime?
  authority             BootstrapAuthority          @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  player                Player                      @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerCommandState    BootstrapPlayerCommandState @relation(fields: [playerId], references: [playerId], onDelete: Restrict, map: "BootstrapProvisioningEpoch_player_command_state_fkey")
  provisionedRestaurant Restaurant                  @relation(fields: [provisionedRestaurantId], references: [id], onDelete: Restrict)
  ownerMembership       RestaurantMembership        @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  save                  CompetitiveSave             @relation(fields: [saveId], references: [id], onDelete: Restrict)
  ownerAuditLog         AuditLog                    @relation(fields: [ownerAuditLogId], references: [id], onDelete: Restrict)
  predecessor           BootstrapProvisioningEpoch? @relation("BootstrapEpochLineage", fields: [predecessorEpochId], references: [id], onDelete: Restrict)
  successor             BootstrapProvisioningEpoch? @relation("BootstrapEpochLineage")

  @@unique([authorityId, epochNumber])
  @@unique([playerId, playerCommandVersion])
  @@index([playerId, status])
  @@index([authorityId, createdAt])
}

/// Durable D02 aggregate version for bootstrap commands. Its Player scope does
/// not reset when a provisioning epoch is cleared or authority lineage changes.
model BootstrapPlayerCommandState {
  playerId  String   @id
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  epochs    BootstrapProvisioningEpoch[]
}

model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  name         String
  address      String?
  hours        String?
  tables       Table[]
  menuItems    MenuItem[]
  orders       Order[]

  @@unique([restaurantId, id])
  @@index([restaurantId])
}

model Table {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code     String
  seats    Int
  status   String  @default("AVAILABLE")
  orders   Order[]

  @@unique([branchId, code])
  @@unique([branchId, id])
  @@index([branchId])
}

model MenuItem {
