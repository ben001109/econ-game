  reversesTransactionId String?               @unique
  createdAt             DateTime              @default(now())
  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                  CompetitiveSave       @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  actorPlayer           Player                @relation("D03LedgerActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)
  reverses              LedgerTransaction?    @relation("D03LedgerCompensation", fields: [restaurantId, saveId, reversesTransactionId], references: [restaurantId, saveId, id], onDelete: Restrict)
  compensation          LedgerTransaction?    @relation("D03LedgerCompensation")
  lines                 LedgerLine[]
  outboxEvent           OutboxEvent?
  simulationJobs        SimulationJob[]       @relation("D03SimulationSourceTransaction")
  inventoryTransactions InventoryTransaction[]

  @@unique([restaurantId, saveId, id])
  @@unique([restaurantId, saveId, id, commandId])
  @@unique([restaurantId, saveId, reversesTransactionId])
  @@index([restaurantId, saveId, createdAt])
  @@index([actorPlayerId, createdAt])
}

model LedgerLine {
  id            String            @id
  restaurantId  String
  saveId        String
  transactionId String
  sequence      Int
  accountCode   String
  direction     LedgerDirection
  amountMinor   BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [restaurantId, saveId, transactionId], references: [restaurantId, saveId, id], onDelete: Restrict)

  @@unique([transactionId, sequence])
  @@index([restaurantId, saveId, accountCode, createdAt])
}

model OutboxEvent {
  id                   String                  @id
  restaurantId         String
  saveId               String
  transactionId        String?                 @unique
  causationCommandId   String
  eventSequence        Int                     @default(0)
  aggregateType        String
  aggregateId          String
  aggregateVersion     Int
  eventType            String
  eventVersion         Int                     @default(1)
  payload              Json
  occurredAt           DateTime                @default(now())
  restaurant           Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                 CompetitiveSave         @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  transaction          LedgerTransaction?      @relation(fields: [restaurantId, saveId, transactionId], references: [restaurantId, saveId, id], onDelete: Restrict)
  receipts             OutboxConsumerReceipt[]
  deadLetters          OutboxConsumerDeadLetter[]
  simulationJobs       SimulationJob[]
  materializedMarketTicks MarketTick[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, saveId, transactionId])
  @@unique([restaurantId, saveId, id, causationCommandId])
  @@unique([causationCommandId, eventSequence])
  @@index([restaurantId, saveId, occurredAt])
  @@index([restaurantId, saveId, causationCommandId])
}

model OutboxConsumerReceipt {
  id           String      @id
  restaurantId String
  eventId      String
  consumerName String
  processedAt  DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  event        OutboxEvent @relation(fields: [restaurantId, eventId], references: [restaurantId, id], onDelete: Restrict)

  @@unique([eventId, consumerName])
  @@index([restaurantId, consumerName, processedAt])
}

model OutboxConsumerDeadLetter {
  id           String      @id
  restaurantId String
  eventId      String
  consumerName String
  eventType    String
  eventVersion Int
  errorCode    String
  errorDetails Json
  failedAt     DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  event        OutboxEvent @relation(fields: [restaurantId, eventId], references: [restaurantId, id], onDelete: Restrict)

  @@unique([eventId, consumerName])
  @@index([restaurantId, consumerName, failedAt])
  @@index([errorCode, failedAt])
}

model SimulationVersionArtifact {
  id           String                 @id
  artifactKind SimulationArtifactKind
  artifactKey  String
  version      String
  processorId  String?
  payload      Json
  payloadHash  String                 @db.VarChar(64)
  createdAt    DateTime               @default(now())

  @@unique([artifactKind, artifactKey, version])
  @@index([artifactKind, artifactKey, createdAt])
}

model SimulationJob {
  id                  String                    @id
  restaurantId        String
  saveId              String
  sourceEventId       String
  sourceTransactionId String?
  jobKind             String
  businessKey         String
  status              SimulationJobStatus       @default(PENDING)
  inputPayload        Json
  inputHash           String                    @db.VarChar(64)
  resultPayload       Json?
  attemptCount        Int                       @default(0)
  maxAttempts         Int                       @default(5)
  availableAt         DateTime                  @default(now())
  leaseOwner          String?
  leaseToken          String?
  leaseExpiresAt      DateTime?
  errorClass          SimulationJobErrorClass?
  errorCode           String?
  errorDetails        Json?
  startedAt           DateTime?
  terminalAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  restaurant          Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                CompetitiveSave           @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  sourceEvent         OutboxEvent               @relation(fields: [restaurantId, sourceEventId], references: [restaurantId, id], onDelete: Restrict)
  sourceTransaction   LedgerTransaction?        @relation("D03SimulationSourceTransaction", fields: [restaurantId, saveId, sourceTransactionId], references: [restaurantId, saveId, id], onDelete: Restrict)
  audits              SimulationJobAudit[]
  materializedTicks   MarketTick[]
  replayExecution     VersionedReplayExecution?

  @@unique([restaurantId, id])
  @@unique([sourceEventId, jobKind, businessKey])
  @@index([status, availableAt, createdAt])
  @@index([restaurantId, saveId, createdAt])
  @@index([leaseExpiresAt])
}

model SimulationJobAudit {
  id           String        @id
  restaurantId String
  jobId        String
  action       String
  attempt      Int
  details      Json
  occurredAt   DateTime      @default(now())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  job          SimulationJob @relation(fields: [restaurantId, jobId], references: [restaurantId, id], onDelete: Restrict)

  @@index([restaurantId, jobId, occurredAt])
  @@index([action, occurredAt])
}

model VersionedReplayExecution {
  id                String          @id
  restaurantId      String
  saveId            String
  jobId             String          @unique
  replayKind        String
  businessDay       Int?
  ruleArtifactKey   String
  ruleVersion       String
  rulePayloadHash   String          @db.VarChar(64)
  catalogSelections Json
  replayPayload     Json
  replayInputHash   String          @db.VarChar(64)
  resultPayload     Json
  resultHash        String          @db.VarChar(64)
  createdAt         DateTime        @default(now())
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save              CompetitiveSave @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict)
  job               SimulationJob   @relation(fields: [restaurantId, jobId], references: [restaurantId, id], onDelete: Restrict)
  businessDayRecord BusinessDay?    @relation(fields: [restaurantId, saveId, businessDay], references: [restaurantId, saveId, businessDay], onDelete: Restrict)
  marketTicks       MarketTick[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, jobId])
  @@index([restaurantId, saveId, replayKind, createdAt])
}

model MarketTick {
  id                    String                   @id
  restaurantId          String
  saveId                String
  businessDay           Int
  tickKind              String
  materializationSource MarketTickMaterializationSource @default(JOB)
  materializedByJobId   String?
  replayExecutionId     String?
  materializedByCommandId String?
  sourceEventId         String?
  marketSeed            String
  ruleArtifactKey       String
  simulationRuleVersion String
  rulePayloadHash       String                   @db.VarChar(64)
  catalogArtifactKey    String
  catalogRevision       String
  catalogPayloadHash    String                   @db.VarChar(64)
  prngCursor            Int
  inputPayload          Json
  outputPayload         Json
  outputHash            String                   @db.VarChar(64)
  createdAt             DateTime                 @default(now())
  restaurant            Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  save                  CompetitiveSave          @relation(fields: [restaurantId, saveId], references: [restaurantId, id], onDelete: Restrict, map: "MarketTick_save_scope_fkey")
  materializedByJob     SimulationJob?            @relation(fields: [restaurantId, materializedByJobId], references: [restaurantId, id], onDelete: Restrict)
  replayExecution       VersionedReplayExecution? @relation(fields: [restaurantId, replayExecutionId], references: [restaurantId, id], onDelete: Restrict)
  sourceEvent           OutboxEvent?              @relation(fields: [restaurantId, saveId, sourceEventId, materializedByCommandId], references: [restaurantId, saveId, id, causationCommandId], onDelete: Restrict)
  marketSeedAuthority   MarketSeedAuthority       @relation(fields: [restaurantId, saveId], references: [restaurantId, saveId], onDelete: Restrict, map: "MarketTick_market_seed_authority_scope_fkey")
  businessDayRecord     BusinessDay               @relation(fields: [restaurantId, saveId, businessDay], references: [restaurantId, saveId, businessDay], onDelete: Restrict)

  @@unique([saveId, businessDay, tickKind])
  @@index([restaurantId, saveId, businessDay])
  @@index([materializedByJobId])
  @@index([sourceEventId])
}
